;   1:	Initialize file, get everything working the way that I thought it should    *
;	work.									    *
;										    *
;   2:	  I2C communications for enabling/disabling the target as well as reporting *
;          any player hits to the target when the target is enabled.		    *
;										    *
;************************************************************************************		
    
#include <xc.inc>

    
//SUBROUTINES_CODE CODE
    PSECT code
    ;RECEIVES AND INTERPRETS I2C DATA, RESPONDS TO I2C READ REQUESTS
RECEIVE: 
	    BANKSEL	PIR1
	    BCF		SSP1IF		;IMMEDIATELY CLEAR INTERRUPT FLAG
	    BANKSEL	SSP1BUF			;\READ BYTE FROM MASTER
	    MOVF	SSP1BUF,0
	    BANKSEL	PORTA	    ;/
	    MOVWF	RECEIVED_DATA
	    BANKSEL	SSP1STAT		;DETERMINE IF THE RECEIVED BYTE WAS DATA OR ADDRESS
	    BTFSS	SSP1STAT,5		;1=DATA, 0=ADDRESS
	    GOTO	CHECK_READ_OR_WRITE	;BYTE RECEIVED WAS ADDRESS, CHECK IF R/W
	    GOTO	SAVE_DATA		;BYTE RECEIVED WAS DATA, SAVE BYTE
	    
	CHECK_READ_OR_WRITE:
	    BTFSS	SSP1STAT,2		;TEST IF ADDRESS BYTE WAS R/W: R = 1, W = 0
	    GOTO	SAVE_DATA   				;MASTER WRITE: SAVE DATA
	    GOTO	TRANSMIT_STATUS		;MASTER READ: TRANSMIT THE TARGET STATUS
	
	;TESTS THE RECEIVED DATA AGAINST THE KNOWN ENABLE AND DISABLE COMMANDS
	SAVE_DATA:
	    BANKSEL	PORTA
	    BANKSEL	SSP1STAT
	    BTFSC	BF
	    GOTO	$-1
	    BANKSEL	PIR1
	    BCF		SSP1IF
	    BANKSEL	SSP1BUF
	    MOVF	SSP1BUF,0
	    BANKSEL	PORTA
	    MOVWF	RECEIVED_DATA
	    //BTFSC	I2C_ColorFlag,0
	    //CALL	CHANGE_COLOR
	    MOVF	RECEIVED_DATA,0
	    XORLW	0X45
	    BTFSC	ZERO	    ;IF RECEIVED BYTE IS ENABLE COMMAND, SET TARGET TO ACTIVE
	    BSF		ACTIVE, 0	    
	    MOVF	RECEIVED_DATA,0
	    XORLW	0X44
	    BTFSC	ZERO	    ;IF RECEIVED BYTE IS DISABLE COMMAND, SET TARGET TO INACTIVE
	    BCF		ACTIVE, 0
	   // MOVF	RECEIVED_DATA,0
	   // XORLW	0X43
	   // BTFSC	ZERO
	   // CALL	CHANGE_COLOR
	    RETURN
	    
	CHANGE_COLOR:
	    BSF		I2C_ColorFlag,0
	    INCF	I2C_Color_Count
	    MOVF	I2C_Color_Count,0
	    XORLW	0X01
	    BTFSC	ZERO
	    RETURN
	    MOVF	I2C_Color_Count,0
	    XORLW	0X02
	    BTFSC	ZERO
	    GOTO	Player_Number
	    MOVF	I2C_Color_Count,0
	    XORLW	0x03
	    BTFSC	ZERO
	    GOTO	Green
	    MOVF	I2C_Color_Count,0
	    XORLW	0x04
	    BTFSC	ZERO
	    GOTO	Red
	    MOVF	I2C_Color_Count,0
	    XORLW	0x05
	    BTFSC	ZERO
	    GOTO	Blue
	    BCF		I2C_ColorFlag,0
	    CLRF	I2C_Color_Count
	    RETURN
	    
	    //Sets the flag in accordance
	    //to what player color is being changed
	    Player_Number:
	    MOVF	RECEIVED_DATA,0
	    XORLW	0x01
	    BTFSC	ZERO
	    BSF		I2C_ColorFlag,1
	    MOVF	RECEIVED_DATA,0
	    XORLW	0x02
	    BTFSC	ZERO
	    BSF		I2C_ColorFlag,2
	    MOVF	RECEIVED_DATA,0
	    XORLW	0x03
	    BTFSC	ZERO
	    BSF		I2C_ColorFlag,3
	    MOVF	RECEIVED_DATA,0
	    XORLW	0x04
	    BTFSC	ZERO
	    BSF		I2C_ColorFlag,4
	    RETURN
	    
	    //For changing Green color based
	    //off of player number
	    Green:
	    BTFSC	I2C_ColorFlag,1
	    GOTO	Player1_Green
	    BTFSC	I2C_ColorFlag,2
	    GOTO	Player2_Green
	    BTFSC	I2C_ColorFlag,3
	    GOTO	Player3_Green
	    BTFSC	I2C_ColorFlag,4
	    GOTO	Player4_Green
	    RETURN
	    Player1_Green:
	    MOVLW	0x21
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P1_G
	    Call	Write_EEPROM
	    RETURN
	    Player2_Green:
	    MOVLW	0x24
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P2_G
	    Call	Write_EEPROM
	    RETURN
	    Player3_Green:
	    MOVLW	0x27
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P3_G
	    Call	Write_EEPROM
	    RETURN
	    Player4_Green:
	    MOVLW	0x2A
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P4_G
	    Call	Write_EEPROM
	    RETURN
	    
	    //For changing the red color based off of
	    //Player number
	    Red:
	    BTFSC	I2C_ColorFlag,1
	    GOTO	Player1_RED
	    BTFSC	I2C_ColorFlag,2
	    GOTO	Player2_RED
	    BTFSC	I2C_ColorFlag,3
	    GOTO	Player3_RED
	    BTFSC	I2C_ColorFlag,4
	    GOTO	Player4_RED
	    RETURN
	    Player1_RED:
	    MOVLW	0x20
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P1_R
	    Call	Write_EEPROM
	    RETURN
	    Player2_RED:
	    MOVLW	0x23
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P2_R
	    Call	Write_EEPROM
	    RETURN
	    Player3_RED:
	    MOVLW	0x26
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P3_R
	    Call	Write_EEPROM
	    RETURN
	    Player4_RED:
	    MOVLW	0x29
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P4_R
	    Call	Write_EEPROM
	    RETURN
	    
	    //For changing the Blue color
	    //based off of player number
	    Blue:
	    BTFSC	I2C_ColorFlag,1
	    GOTO	Player1_Blue
	    BTFSC	I2C_ColorFlag,2
	    GOTO	Player2_Blue
	    BTFSC	I2C_ColorFlag,3
	    GOTO	Player3_Blue
	    BTFSC	I2C_ColorFlag,4
	    GOTO	Player4_Blue
	    RETURN
	    Player1_Blue:
	    MOVLW	0x22
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P1_B
	    Call	Write_EEPROM
	    RETURN
	    Player2_Blue:
	    MOVLW	0x25
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P2_B
	    Call	Write_EEPROM
	    RETURN
	    Player3_Blue:
	    MOVLW	0x28
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P3_B
	    Call	Write_EEPROM
	    RETURN
	    Player4_Blue:
	    MOVLW	0x2B
	    MOVWF	EEPROM_ADDR
	    MOVF	RECEIVED_DATA,0
	    MOVWF	EEPROM_DATA
	    MOVWF	P4_B
	    Call	Write_EEPROM
	    RETURN
	    
    
	;TRANSMIT THE CURRENT TARGET STATUS BACK TO THE MASTER IF A READ WAS RECEIVED
	TRANSMIT_STATUS:
	    BANKSEL	PORTA
	    MOVF	PLAYER_HIT,0	    ;RETREIVE THE CURRENT PLAYER NUMBER THAT HIT THE TARGET
	    BANKSEL	SSP1BUF
	    MOVWF	SSP1BUF		    ;MOVE THE PLAYER NUMBER INTO THE I2C BUFFER
	    BANKSEL	SSP1CON1
	    BSF		CKP	    ;START THE CLOCK TO BEGIN DATA TRANSMISSION
	    BANKSEL	PORTA
	    CLRF	PLAYER_HIT
	    RETURN
	    
EUSART_RX:
	    BANKSEL	PIR1
	    BCF		RCIF
	    BANKSEL	RC1STA
	    MOVF	RC1STA,0
	    BANKSEL	PORTA
	    MOVWF	EU_RX
	    BTFSC	EU_FLAG,0
	    GOTO	WRITE_I2C
	    BTFSC	EU_FLAG,1
	    GOTO	READ_I2C
	    BTFSC	EU_FLAG,2
	    GOTO	PLAYER_COLOR
	    BTFSC	EU_FLAG,3
	    GOTO	BLASTER
	    BTFSC	EU_FLAG,4
	    GOTO	POSITION
	    BTFSC	EU_FLAG,5
	    GOTO	UPDATE_LED
	    MOVF	EU_RX,0
	    XORLW	0X3C
	    BTFSC	ZERO
	    GOTO	BLASTER
	    MOVF	EU_RX,0
	    XORLW	0X24
	    BTFSC	ZERO
	    GOTO	DOLLAR
	    MOVF	EU_RX,0
	    XORLW	0X56
	    BTFSC	ZERO
	    GOTO	DEVICE_VERIFICATION
	    MOVF	EU_RX,0
	    XORLW	0X57
	    BTFSC	ZERO
	    GOTO	WRITE_I2C
	    MOVF	EU_RX,0
	    XORLW	0X52
	    BTFSC	ZERO
	    GOTO	READ_I2C
	    MOVF	EU_RX,0
	    XORLW	0X53
	    BTFSC	ZERO
	    GOTO	READ_SETTINGS
	    MOVF	EU_RX,0
	    XORLW	0X43
	    BTFSC	ZERO
	    GOTO	PLAYER_COLOR
	    MOVF	EU_RX,0
	    XORLW	0X50
	    BTFSC	ZERO
	    GOTO	POSITION
	    MOVF	EU_RX,0
	    XORLW	0X4C
	    BTFSC	ZERO
	    GOTO	UPDATE_LED
	    GOTO	NULL
	    RETURN
	    
    BLASTER:
	    BANKSEL	PORTA
	    BTFSS	EU_FLAG,7
	    RETURN
	    BSF		EU_FLAG,3
	    INCF	EU_COUNTER
	    MOVF	EU_COUNTER,0
	    XORLW	0X01
	    BTFSC	ZERO
	    RETURN
	    MOVF	EU_COUNTER,0
	    XORLW	0X02
	    BTFSC	ZERO
	    GOTO	HIT_PLAYER
	    MOVF	EU_COUNTER,0
	    XORLW	0X03
	    BTFSC	ZERO
	    GOTO	CHECK_END
	    BCF		EU_FLAG,7
	    BCF		EU_FLAG,3
	    RETURN
	    
	HIT_PLAYER:
	    MOVF	EU_RX,0
	    MOVWF	PLAYER_HIT
	    XORLW	0X01
	    BTFSC	ZERO
	    GOTO	PLAYER1_HIT
	    MOVF	PLAYER_HIT,0
	    XORLW	0X02
	    BTFSC	ZERO
	    GOTO	PLAYER2_HIT
	    MOVF	PLAYER_HIT,0
	    XORLW	0X03
	    BTFSC	ZERO
	    GOTO	PLAYER3_HIT
	    MOVF	PLAYER_HIT,0
	    XORLW	0X04
	    BTFSC	ZERO
	    GOTO	PLAYER4_HIT
	    RETURN
	    PLAYER1_HIT:
	    MOVF	P1_G,0
	    MOVWF	_SENDLEDGREEN
	    MOVF	P1_R,0
	    MOVWF	_SENDLEDRED
	    MOVF	P1_B,0
	    MOVWF	_SENDLEDBLUE
	    BCF		GIE
	    CALL	_SENDLED
	    CALL	FLASH_LED_P1
	    RETURN
	    PLAYER2_HIT:
	    MOVF	P2_G,0
	    MOVWF	_SENDLEDGREEN
	    MOVF	P2_R,0
	    MOVWF	_SENDLEDRED
	    MOVF	P2_B,0
	    MOVWF	_SENDLEDBLUE
	    BCF		GIE
	    CALL	_SENDLED
	    CALL	FLASH_LED_P2
	    RETURN
	    PLAYER3_HIT:
	    MOVF	P3_G,0
	    MOVWF	_SENDLEDGREEN
	    MOVF	P3_R,0
	    MOVWF	_SENDLEDRED
	    MOVF	P3_B,0
	    MOVWF	_SENDLEDBLUE
	    BCF		GIE
	    CALL	_SENDLED
	    CALL	FLASH_LED_P3
	    RETURN
	    PLAYER4_HIT:
	    MOVF	P4_G,0
	    MOVWF	_SENDLEDGREEN
	    MOVF	P4_R,0
	    MOVWF	_SENDLEDRED
	    MOVF	P4_B,0
	    MOVWF	_SENDLEDBLUE
	    BCF		GIE
	    CALL	_SENDLED
	    CALL	FLASH_LED_P4
	    RETURN
	    
	FLASH_LED_P1:
	    CALL	WAIT_FOR_TMR1
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    CALL	WAIT_FOR_TMR1
	    MOVF	P1_R,0
	    MOVWF	_SENDLEDRED
	    MOVF	P1_G,0
	    MOVWF	_SENDLEDGREEN
	    MOVF	P1_B,0
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    CALL	WAIT_FOR_TMR1
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    RETURN
	    
	FLASH_LED_P2:
	    CALL	WAIT_FOR_TMR1
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    CALL	WAIT_FOR_TMR1
	    MOVF	P2_R,0
	    MOVWF	_SENDLEDRED
	    MOVF	P2_G,0
	    MOVWF	_SENDLEDGREEN
	    MOVF	P2_B,0
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    CALL	WAIT_FOR_TMR1
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    RETURN
	    
	FLASH_LED_P3:
	    CALL	WAIT_FOR_TMR1
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    CALL	WAIT_FOR_TMR1
	    MOVF	P3_R,0
	    MOVWF	_SENDLEDRED
	    MOVF	P3_G,0
	    MOVWF	_SENDLEDGREEN
	    MOVF	P3_B,0
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    CALL	WAIT_FOR_TMR1
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    RETURN
	    
	FLASH_LED_P4:
	    CALL	WAIT_FOR_TMR1
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    CALL	WAIT_FOR_TMR1
	    MOVF	P4_R,0
	    MOVWF	_SENDLEDRED
	    MOVF	P4_G,0
	    MOVWF	_SENDLEDGREEN
	    MOVF	P4_B,0
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    CALL	WAIT_FOR_TMR1
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    CALL	_SENDLED
	    RETURN
	    
	CHECK_END:
	    MOVF	EU_RX,0
	    XORLW	0X3E
	    BTFSC	ZERO
	    GOTO	CLEAR_STUFF
	    RETURN
	    CLEAR_STUFF:
	    CLRF	PLAYER_HIT
	    RETURN
	    
    DOLLAR:
	    BANKSEL	PORTA
	    BSF		EU_FLAG,7
	    RETURN
	    
    DEVICE_VERIFICATION:
	    BANKSEL	PORTA
	    BTFSS	EU_FLAG,7
	    RETURN
	    BSF		EU_TXFLAG,0
	    BANKSEL	PIE1
	    BSF		TXIE
	    BANKSEL	PORTA
	    BCF		EU_FLAG,7
	    RETURN
	    
    WRITE_I2C:
	    BANKSEL	PORTA
	    BTFSS	EU_FLAG,7
	    RETURN
	    BSF		EU_FLAG,0
	    INCF	EU_COUNTER
	    MOVF	EU_COUNTER,0
	    XORLW	0X03
	    BTFSS	ZERO
	    RETURN
	    CLRF	EU_COUNTER
	    BSF		EU_TXFLAG,7
	    BANKSEL	PIE1
	    BSF		TXIE
	    BANKSEL	PORTA
	    BCF		EU_FLAG,7
	    BCF		EU_FLAG,0
	    RETURN
	    
    READ_I2C:
	    BANKSEL	PORTA
	    BTFSS	EU_FLAG,7
	    RETURN
	    BSF		EU_FLAG,1
	    INCF	EU_COUNTER
	    MOVF	EU_COUNTER
	    XORLW	0X02
	    BTFSS	ZERO
	    RETURN
	    BSF		EU_TXFLAG,7
	    BANKSEL	PIE1
	    BSF		TXIE
	    BANKSEL	PORTA
	    CLRF	EU_COUNTER
	    BCF		EU_FLAG,7
	    BCF		EU_FLAG,1
	    RETURN
	    
    READ_SETTINGS:
	    BANKSEL	PORTA
	    BTFSS	EU_FLAG,7
	    RETURN
	    BSF		EU_TXFLAG,2
	    BANKSEL	PIE1
	    BSF		TXIE
	    BANKSEL	PORTA
	    BCF		EU_FLAG,7
	    RETURN
	    
    PLAYER_COLOR:
	    BANKSEL	PORTA
	    BTFSS	EU_FLAG,7
	    RETURN
	    BSF		EU_FLAG,2
	    MOVF	EU_RX,0
	    MOVWF	RECEIVED_DATA
	    INCF	EU_COUNTER
	    MOVF	EU_COUNTER,0
	    XORLW	0X01
	    BTFSC	ZERO
	    RETURN
	    MOVF	EU_COUNTER,0
	    XORLW	0X02
	    BTFSC	ZERO
	    GOTO	Player_Number
	    MOVF	EU_COUNTER,0
	    XORLW	0X03
	    BTFSC	ZERO
	    GOTO	Green
	    MOVF	EU_COUNTER,0
	    XORLW	0X04
	    BTFSC	ZERO
	    GOTO	Red
	    MOVF	EU_COUNTER,0
	    XORLW	0X05
	    BTFSC	ZERO
	    CALL	Blue
	    BSF		EU_TXFLAG,1
	    BANKSEL	PIE1
	    BSF		TXIE
	    BANKSEL	PORTA
	    CLRF	EU_COUNTER
	    BCF		EU_FLAG,7
	    BCF		EU_FLAG,2
	    RETURN
	    
    POSITION:
	    BANKSEL	PORTA
	    BTFSS	EU_FLAG,7
	    RETURN
	    BSF		EU_FLAG,4
	    INCF	EU_COUNTER
	    MOVF	EU_COUNTER,0
	    XORLW	0X01
	    BTFSC	ZERO
	    RETURN
	    MOVF	EU_COUNTER,0
	    XORLW	0X02
	    BTFSC	ZERO
	    GOTO	OUTPUT
	    MOVF	EU_COUNTER,0
	    XORLW	0X03
	    BTFSC	ZERO
	    GOTO	POS_H
	    MOVF	EU_COUNTER,0
	    XORLW	0X04
	    BTFSC	ZERO
	    CALL	POS_L
	    BSF		EU_TXFLAG,1
	    BANKSEL	PIE1
	    BSF		TXIE
	    BANKSEL	PORTA
	    CLRF	EU_COUNTER
	    BCF		EU_FLAG,7
	    BCF		EU_FLAG,4
	    RETURN
	    
	OUTPUT:
	    BANKSEL	PORTA
	    MOVF	EU_RX,0
	    MOVWF	EEPROM_DATA
	    MOVWF	CAL_POS
	    MOVLW	0X30
	    MOVWF	EEPROM_ADDR
	    CALL	Write_EEPROM
	    RETURN
	    
	POS_H:
	    BANKSEL	PORTA
	    MOVF	EU_RX,0
	    BTFSC	ZERO
	    RETURN
	    MOVWF	EEPROM_DATA
	    BTFSC	CAL_POS,0
	    GOTO	H_EN
	    GOTO	H_DIS
	    RETURN
	    H_EN:
	    BTFSC	CAL_POS,7
	    CALL	S1h_EN
	    BTFSC	CAL_POS,6
	    CALL	S2h_EN
	    BTFSC	CAL_POS,5
	    CALL	S3h_EN
	    RETURN
	    H_DIS:
	    BTFSC	CAL_POS,7
	    CALL	S1h_DIS
	    BTFSC	CAL_POS,6
	    CALL	S2h_DIS
	    BTFSC	CAL_POS,5
	    CALL	S3h_DIS
	    RETURN
	    S1h_EN:
	    MOVF	EU_RX,0
	    MOVWF	S1E_PH
	    BANKSEL	PSMC1DCH
	    MOVWF	PSMC1DCH
	    BANKSEL	PSMC1CON
	    MOVLW	0XC0
	    MOVWF	PSMC1CON
	    BANKSEL	PORTA
	    MOVLW	0X31
	    MOVWF	EEPROM_ADDR
	    CALL	Write_EEPROM
	    RETURN
	    S2h_EN:
	    MOVF	EU_RX,0
	    MOVWF	S2E_PH
	    BANKSEL	PSMC2DCH
	    MOVWF	PSMC2DCH
	    BANKSEL	PSMC2CON
	    MOVLW	0XC0
	    MOVWF	PSMC2CON
	    BANKSEL	PORTA
	    MOVLW	0X35
	    MOVWF	EEPROM_ADDR
	    CALL	Write_EEPROM
	    RETURN
	    S3h_EN:
	    MOVF	EU_RX,0
	    MOVWF	S3E_PH
	    BANKSEL	PSMC3DCH
	    MOVWF	PSMC3DCH
	    BANKSEL	PSMC3CON
	    MOVLW	0XC0
	    MOVWF	PSMC3CON
	    BANKSEL	PORTA
	    MOVLW	0X39
	    MOVWF	EEPROM_ADDR
	    CALL	Write_EEPROM
	    RETURN
	    S1h_DIS:
	    MOVF	EU_RX,0
	    MOVWF	S1D_PH
	    BANKSEL	PSMC1DCH
