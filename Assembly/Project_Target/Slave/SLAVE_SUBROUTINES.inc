    ;LOOPS UNTIL TMR1 OVERFLOW
WAIT_FOR_TMR1:
	    BCF		PIR1,0			;CLEAR TMR1IF
	    BANKSEL	T1CON
	    BSF		T1CON,0			;ENABLE TIMER 1
	    BANKSEL	TMR1L
	    CLRF	TMR1L			;/RESET TMR1 FOR FULL TIMING
	    CLRF	TMR1H			;\
	    BCF		PIR1,0			;CLEAR TMR1IF
	    BTFSS	PIR1,0			;POLL TMR1IF UNTIL COMPLETE
	    GOTO	$-1			;TMR1 NOT DONE
	    BANKSEL	T1CON
	    BCF		T1CON,0			;DISABLE TIMER 1
	    RETURN
	    
    ;TURNS OFF ALL LEDS ON THE TARGET
TURN_OFF_LEDS:
	    BANKSEL	_LEDNUMBER
	    MOVLW	0X01
	    MOVWF	_LEDNUMBER
	    MOVLW	0X00
	    MOVWF	_SENDLEDRED
	    MOVWF	_SENDLEDGREEN
	    MOVWF	_SENDLEDBLUE
	    BCF		GIE
	    CALL	_SENDLED
	    BSF		GIE
	    RETURN
	    
    ;TURNS ON THE LEDS ASSOCIATED WITH AN ACTIVE TARGET
TURN_ON_LEDS:
	    BANKSEL	PORTA
	    MOVLW	0X11
	    MOVWF	EEPROM_ADDR
	    CALL	Read_EEPROM
	    BANKSEL	PORTA
	    MOVF	EEPROM_SAVE,0
	    MOVWF	_SENDLEDRED
	    MOVLW	0X12
	    MOVWF	EEPROM_ADDR
	    CALL	Read_EEPROM
	    BANKSEL	PORTA
	    MOVF	EEPROM_SAVE,0
	    MOVWF	_SENDLEDGREEN
	    MOVLW	0X13
	    MOVWF	EEPROM_ADDR
	    CALL	Read_EEPROM
	    BANKSEL	PORTA
	    MOVF	EEPROM_SAVE,0
	    MOVWF	_SENDLEDBLUE
	    BCF		GIE
	    CALL	_SENDLED
	    BSF		GIE
	    RETURN

	;Writes to EEPROM
	;**** Do not under any circumstances ****
	;**** Use EEPROM row 0 it is evil ****
Write_EEPROM:
	    BANKSEL	PORTA
	    MOVF	EEPROM_ADDR,0
	    BANKSEL	EEADRL
	    MOVWF	EEADRL
	    BANKSEL	PORTA
	    MOVF	EEPROM_DATA,0
	    BANKSEL	EEDATL
	    MOVWF	EEDATL
	    BCF		EECON1,6
	    BCF		EECON1,7
	    BSF		EECON1,2

	    BCF		INTCON,7
	    MOVLW	0x55
	    MOVWF	EECON2
	    MOVLW	0xAA
	    MOVWF	EECON2
	    BSF		WR
    Loop:   BSF		GIE
	    BCF		WREN
	    BTFSC	WR
	    GOTO	Loop
	    RETURN

	;Reads from EEPROM
	;**** Do not under any circumstances ****
	;**** Use EEPROM row 0 it is evil ****
Read_EEPROM:
	    BANKSEL	PORTA
	    MOVF	EEPROM_ADDR,0
	    BANKSEL	EEADRL
	    MOVWF	EEADRL
	    BANKSEL	EECON1
	    BCF		EECON1,6
	    BCF		EECON1,7
	    BSF		EECON1,0
	    MOVF	EEDATL,0
	    BANKSEL	PORTA
	    MOVWF	EEPROM_SAVE
	    RETURN
	    
	    
_FIRSTTIMESETUP:
           ;**** Do not under any circumstances ****
	   ;**** Use EEPROM row 0 it is evil ****
	    ;This runs the first time address setup of 1
	    BANKSEL	PORTA
	    MOVLW	0x10
	    MOVWF	EEPROM_ADDR
	    MOVLW	0x01
	    MOVWF	EEPROM_DATA
	    CALL	Write_EEPROM
	    ;This runs setup for the red value for init target of 0
	    BANKSEL	PORTA
	    MOVLW	0X11
	    MOVWF	EEPROM_ADDR
	    MOVLW	0X00
	    MOVWF	EEPROM_DATA
	    CALL	Write_EEPROM
	    ;This runs setup for the green value for init target of 255
	    BANKSEL	PORTA
	    MOVLW	0X12
	    MOVWF	EEPROM_ADDR
	    MOVLW	0XFF
	    MOVWF	EEPROM_DATA
	    CALL	Write_EEPROM
	    ;This runs setup for the blue value for init target of 0
	    BANKSEL	PORTA
	    MOVLW	0X13
	    MOVWF	EEPROM_ADDR
	    MOVLW	0X00
	    MOVWF	EEPROM_DATA
	    CALL	Write_EEPROM
	    BANKSEL	PORTA
	    
	    BANKSEL	PORTA
	    MOVLW	0X60
	    MOVWF	EEPROM_ADDR
	    MOVLW	0X01
	    MOVWF	EEPROM_DATA
	    CALL	Write_EEPROM
	    BANKSEL	PORTA
	    
	    ;All player colors will initally be white because the EEPROM inits
	    ;to FF in all registers when programming the pic with
	    ;clear memory enabled
	    RETURN